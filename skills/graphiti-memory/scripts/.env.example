# Секреты контейнера graphiti-mcp и загрузчиков. Скопировать в <deploy_dir>/.env, chmod 600. В git НЕ класть.
# LLM извлечения и эмбеддинги — через OpenAI-совместимый API (у нас OpenRouter): один ключ на всё.
OPENAI_API_KEY=sk-or-v1-REPLACE_ME
# Ключ эмбеддера, если он другой (локальный TEI ключа не требует — любое слово)
EMBEDDER_API_KEY=local
# Пароль FalkorDB (пусто = без пароля; порт и так только на 127.0.0.1)
FALKORDB_PASSWORD=
GRAPHITI_TELEMETRY_ENABLED=false
